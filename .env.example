# Copy to .env and fill in real values. Never commit .env (FA-45: no
# secrets in the repository) — it's already in .gitignore.
#
# docker compose reads .env automatically from the project directory.

# Flask session-signing key for the admin app. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Where the real content directory lives. Defaults to ./data if unset, which
# is fine for local dev but WRONG in production/CI-driven deploys: it must
# be a stable path outside anything a checkout/deploy tool can recreate or
# clean (containers write into it as uid 1000; a checkout running as a
# different host user then can't remove those files during its own
# housekeeping). Use the path the Anforderungskatalog specifies:
DATA_DIR=/var/lib/portfolio
